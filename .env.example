# User/Group IDs — match host user for correct file permissions
USER_ID=1000
GROUP_ID=1000

# Home folder for host file mounts (e.g. /home/youruser)
HOME_FOLDER=/home/youruser

# Pre-built dev container image (build with: make build or scripts/build-dev-image.sh)
DEV_IMAGE=agent47-dev

# Dev container mount paths — one per container
DEV_1_MOUNT=~/development/dev-1
DEV_2_MOUNT=~/development/dev-2
DEV_3_MOUNT=~/development/dev-3
DEV_4_MOUNT=~/development/dev-4
DEV_5_MOUNT=~/development/dev-5
DEV_6_MOUNT=~/development/dev-6
DEV_7_MOUNT=~/development/dev-7
DEV_8_MOUNT=~/development/dev-8
DEV_9_MOUNT=~/development/dev-9
